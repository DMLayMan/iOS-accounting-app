# Draft only: verify the DNS record, filing scope and server before activation.
# Keep the configuration outside the document root. Copy only the two HTML pages.
yuji.rush247tt.xyz {
    root * /srv/yuji-web
    encode gzip

    @unsupported not method GET HEAD
    respond @unsupported "Method not allowed" 405

    @home path /
    redir @home /support.html 302

    @pages path /privacy.html /support.html
    handle @pages {
        file_server
    }
    handle {
        respond "Not found" 404
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
}
